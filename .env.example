# For running the adapter from source: copy to apps/arkiv-adapter/.env and fill
# in. For Docker, use docker.env.example instead. Never commit .env files.
# Every variable is explained in docs/configuration.md.

# Tiramisu RPC (optional; the SDK default is used when empty)
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network

# Funder wallet: tops up issuer wallets with gas. Fund it at
# https://hub.arkiv.network/faucet. TESTNET ONLY.
ARKIV_PRIVATE_KEY=

# Keys of the principals the adapter publishes as (comma-separated). Each
# mandate or revocation is created by its issuer's own wallet, so Arkiv's
# $creator is the issuer. Synthetic demo principals only. TESTNET ONLY.
ARKIV_ISSUER_KEYS=

# Namespace for every Arkiv entity and query.
ARKIV_PROJECT_ID=mandate-global-tour-2026

# Adapter HTTP port, and an optional bearer token required for writes.
PORT=8787
ADAPTER_TOKEN=

RUST_LOG=info

# Arkiv access key (https://hub.arkiv.network/api-keys). Strongly recommended:
# the anonymous query budget is small and the server queries on every decision.
ARKIV_API_KEY=

# mandate-server demo mode (web UI sandbox): synthetic demo principals' keys,
# name=0xkey,... (must include finance-agent). TESTNET DEMO KEYS ONLY.
DEMO_KEYS=

# Optional: WebSocket RPC for live entity events (default: Tiramisu's).
ARKIV_WS_URL=
