# Copy to .env for docker compose (or export for a local run). Never commit .env.
# Every variable is explained in docs/warden.md.

# --- Warden ---------------------------------------------------------------
# Bearer token for the owner endpoints (grant, revoke, checkpoint, restore)
# and the dashboard's owner controls. Generate one: openssl rand -hex 32
WARDEN_ADMIN_TOKEN=

# On a Fly.io Sprite: connector IDs. The connector gateway attaches the
# credential, so the Warden never holds it. Takes precedence over the
# direct credentials below.
GITHUB_CONNECTION_ID=
OLLAMA_CONNECTION_ID=

# Anywhere else (Docker, a laptop): the Warden holds the credentials.
# A fine-grained GitHub token scoped to the repositories the agent may touch.
GITHUB_TOKEN=
# Local Ollama from Docker: http://host.docker.internal:11434
# Ollama cloud: https://ollama.com (set OLLAMA_API_KEY)
OLLAMA_URL=
OLLAMA_API_KEY=

# Sprites only: checkpoint the agent Sprite before every allowed write and
# restore it after a denied write. Needs a Sprites API token.
SPRITES_TOKEN=
AGENT_SPRITE=mandate-agent
WARDEN_CHECKPOINT_ON_WRITE=
WARDEN_RESTORE_ON_DENY=

# --- Agent ----------------------------------------------------------------
# The agent's own signing key (warden-call keygen). Its only secret.
MANDATE_AGENT_KEY=
MANDATE_REPO=OWNER/REPO
MANDATE_MODEL=gpt-oss:120b
