# Environment for the Mandate container (docker compose, docker run --env-file,
# or your host's dashboard). Copy to docker.env and fill in. Never commit it.
# Every variable is explained in docs/configuration.md.

# --- Authorization -----------------------------------------------------------

# Who may issue root mandates for which resource: kind:id=0xaddr[,0xaddr];…
# Without it no root mandate is trusted and every check is DENY.
TRUST_ANCHORS=

# `arkiv` (default): state on Arkiv. `memory`: no Arkiv, state lost on restart.
MANDATE_BACKEND=arkiv

# --- Arkiv (MANDATE_BACKEND=arkiv) ------------------------------------------

# Arkiv access key (https://hub.arkiv.network/api-keys). Strongly recommended:
# the anonymous query budget is small and every decision queries Arkiv.
ARKIV_API_KEY=

# Namespace for every entity and query. Use your own to keep your data apart.
ARKIV_PROJECT_ID=mandate-global-tour-2026

# Keys this server may publish as (comma-separated). Each mandate is created
# by its issuer's own wallet, so only issuers listed here can publish through
# this server. Leave empty for a read-only server (authorize and reads work).
ARKIV_ISSUER_KEYS=

# Optional funder wallet: tops up issuer wallets with gas when they run low.
ARKIV_PRIVATE_KEY=

# Optional RPC overrides (default: Tiramisu testnet).
ARKIV_RPC_URL=
ARKIV_WS_URL=

# --- HTTP --------------------------------------------------------------------

# Browser origins allowed to call the API, comma-separated. Not needed for
# server-to-server calls or for the web UI the server itself serves at /.
CORS_ORIGINS=

# Listen port inside the container (your host may set it for you).
PORT=8080
RUST_LOG=info

# --- Demo sandbox (optional) ---------------------------------------------------

# Synthetic demo keys, name=0xkey,… including finance-agent. Enables the web
# UI's "Revoke it live" sandbox. TESTNET DEMO KEYS ONLY. Leave empty otherwise.
DEMO_KEYS=
DEMO_RESOURCE=
